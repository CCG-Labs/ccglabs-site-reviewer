{
  "name": "@ccglabs/site-reviewer",
  "version": "0.1.0",
  "description": "Automated website review: crawl a URL, run environment-aware quality checks, emit a scored JSON report.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "author": "CCG Labs (https://ccglabs.net)",
  "homepage": "https://github.com/CCG-Labs/ccglabs-site-reviewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CCG-Labs/ccglabs-site-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/CCG-Labs/ccglabs-site-reviewer/issues"
  },
  "keywords": [
    "seo",
    "website-audit",
    "accessibility",
    "lighthouse",
    "quality-assurance",
    "cli"
  ],
  "bin": {
    "site-review": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "peerDependencies": {
    "@axe-core/playwright": ">=4 <5",
    "lighthouse": ">=11 <13",
    "playwright": ">=1.40.0 <2"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "lighthouse": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "domhandler": "^6.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "zod": "^4.6.5"
  }
}
