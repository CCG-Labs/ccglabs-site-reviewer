{
  "name": "@ccglabs/site-reviewer",
  "version": "0.1.0",
  "description": "Automated website review: crawl a URL, run environment-aware quality checks, emit a scored JSON report.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "bin": {
    "site-review": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@axe-core/playwright": ">=4 <5",
    "lighthouse": ">=11 <13",
    "playwright": ">=1.40.0 <2"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "lighthouse": {
      "optional": true
    },
    "@axe-core/playwright": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "domhandler": "^6.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "zod": "^4.4.3"
  }
}
